# Data & model artifacts (large / regenerable — keep folder structure via .gitkeep)
data/*.db
data/raw/*
data/processed/*
data/embeddings/*
models/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/embeddings/.gitkeep
!models/.gitkeep

# Python
