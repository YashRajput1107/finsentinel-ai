*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
src/rag/answer_review.csv 

# runtime artifacts the deployed app needs (raw sources stay ignored)
!data/finsentinel.db
!data/processed/news.parquet
!data/processed/reddit.parquet
!data/processed/rag_index/
!data/processed/rag_index/**
